{
  "name": "tierdom-pro",
  "private": true,
  "version": "0.1.0-alpha.7",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . --cache && eslint .",
    "format": "prettier --write .",
    "verify": "npm run lint && npm run check && npm run test:unit -- --run && npm run test:unit:coverage",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest --run --coverage",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:deterministic": "playwright test --project=det-setup --project=deterministic",
    "test:e2e:reset": "mkdir -p ./test-data && rm -f ./test-data/db.sqlite ./test-data/db.sqlite-shm ./test-data/db.sqlite-wal && DATA_PATH=./test-data npx drizzle-kit migrate && tsx --env-file=.env.test src/lib/server/db/seed.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/lib/server/db/seed.ts",
    "db:reset": "./scripts/db-reset.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/dompurify": "3.2.0",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "3.5.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "12.11.1",
    "fflate": "0.8.3",
    "isomorphic-dompurify": "3.23.0",
    "lucide-svelte": "1.0.1",
    "marked": "17.0.6",
    "papaparse": "5.7.0",
    "sharp": "0.35.5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
